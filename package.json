{
  "name": "swf-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "tsc -b --force && tsc -p packages/swf/tsconfig.test.json && tsc -p apps/decompiler/tsconfig.test.json && tsc -p packages/gfx/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "spec:verify": "python3 tools/verify_docs.py",
    "spec:status": "python3 tools/gen_status.py",
    "audit:dev": "python3 tools/audit_dev.py",
    "clean": "rm -rf packages/*/dist apps/*/dist *.tsbuildinfo packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "eslint": "^10.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.4"
  }
}
