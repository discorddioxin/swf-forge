{
  "name": "swf-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && corepack pnpm -r --filter \"./apps/**\" build",
    "typecheck": "tsc -b --force && tsc -p packages/swf/tsconfig.test.json && tsc -p packages/avm1/tsconfig.test.json && tsc -p apps/decompiler/tsconfig.test.json && tsc -p packages/gfx/tsconfig.test.json && tsc -p apps/engine-flash/tsconfig.test.json && tsc -p packages/audio/tsconfig.test.json && tsc -p packages/assets/tsconfig.test.json && tsc -p packages/compile/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "browser:probe": "node tools/browser-lane.mjs probe",
    "browser:install": "node tools/browser-lane.mjs install",
    "test:fuzz": "vitest run packages/swf/test/fuzz.test.ts",
    "test:avm1-fuzz": "AVM1_FUZZ_1M=1 vitest run packages/avm1/test/actions-mutation.gate.test.ts",
    "test:avm1-restart": "corepack pnpm build && node tools/avm1-restart-probe.mjs",
    "corpus:fetch": "node tools/open-corpus.mjs fetch",
    "corpus:verify": "node tools/open-corpus.mjs verify",
    "corpus:report": "corepack pnpm build && node tools/open-corpus.mjs report",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "spec:verify": "python3 tools/verify_docs.py",
    "spec:status": "python3 tools/gen_status.py",
    "audit:dev": "python3 tools/audit_dev.py",
    "tag:coverage": "python3 tools/tag_coverage.py",
    "adpcm:probe": "python3 tools/adpcm_probe.py",
    "test:audit": "python3 -m unittest discover -s tools -p 'test_*.py'",
    "clean": "rm -rf packages/*/dist apps/*/dist *.tsbuildinfo packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/browser": "2.1.9",
    "eslint": "^10.12.0",
    "playwright": "^1.64.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.4"
  }
}
